ria-label=\"Scroll collections right\"\n    hidden\n  >&#8250;<\/button>\n\n<\/div>\n\n<script>\n(function () {\n\n  const TRANSFER_KEY = 'susans_nav_transfer_v6';\n  const PAGE_KEY = 'susans_nav_page_v6:';\n  const TRANSFER_LIFETIME = 5 * 60 * 1000;\n\n  function normalize(path) {\n    return path.replace(\/\\\/+$\/, '') || '\/';\n  }\n\n  const currentPath = normalize(location.pathname);\n\n  const navEntry =\n    performance.getEntriesByType &&\n    performance.getEntriesByType('navigation')[0];\n\n  const isHistoryReturn =\n    navEntry && navEntry.type === 'back_forward';\n\n  function read(key) {\n    try {\n      return JSON.parse(\n        sessionStorage.getItem(key) || 'null'\n      );\n    } catch (e) {\n      return null;\n    }\n  }\n\n  function write(key, value) {\n    try {\n      sessionStorage.setItem(\n        key,\n        JSON.stringify(value)\n      );\n    } catch (e) {\n      \/\/ Navigation still works without storage.\n    }\n  }\n\n  function remove(key) {\n    try {\n      sessionStorage.removeItem(key);\n    } catch (e) {}\n  }\n\n  function init(root) {\n\n    if (root.dataset.susansNavReady === '1') {\n      return;\n    }\n\n    const track = root.querySelector(\n      '.susans-collection-nav__track'\n    );\n\n    const left = root.querySelector(\n      '.susans-collection-nav__arrow--left'\n    );\n\n    const right = root.querySelector(\n      '.susans-collection-nav__arrow--right'\n    );\n\n    if (!track || !left || !right) return;\n\n    root.dataset.susansNavReady = '1';\n\n    const pageType = root.dataset.pageType || '';\n    const liquidContext =\n      root.dataset.collectionHandle || '';\n\n    \/* RESTORE NAVIGATION CONTEXT *\/\n\n    const transfer = read(TRANSFER_KEY);\n\n    remove(TRANSFER_KEY);\n\n    const incoming = transfer &&\n      transfer.to === currentPath &&\n      Number.isFinite(transfer.x) &&\n      Date.now() - transfer.at >= 0 &&\n      Date.now() - transfer.at < TRANSFER_LIFETIME\n        ? transfer\n        : null;\n\n    const contextFromUrl = location.pathname.match(\n      \/\\\/collections\\\/([^\/]+)\\\/products\\\/\/\n    );\n\n    let context =\n      pageType === 'collection'\n        ? liquidContext\n        : pageType === 'product'\n          ? (\n              liquidContext ||\n              (contextFromUrl && contextFromUrl[1]) ||\n              (incoming && incoming.context) ||\n              ''\n            )\n          : '';\n\n    const activeLink = Array.from(\n      track.querySelectorAll('[data-handle]')\n    ).find(function (link) {\n      return link.dataset.handle === context;\n    });\n\n    if (pageType === 'product' && activeLink) {\n      activeLink.classList.add('is-active');\n    }\n\n    root.dataset.activeContext = context;\n\n    \/* FULL VIEWPORT WIDTH *\/\n\n    function fullWidth() {\n\n      root.style.width = '100%';\n      root.style.marginLeft = '0px';\n\n      const x = root.getBoundingClientRect().left;\n\n      root.style.width =\n        document.documentElement.clientWidth + 'px';\n\n      root.style.marginLeft = -x + 'px';\n    }\n\n    \/* ARROW VISIBILITY *\/\n\n    function updateArrows() {\n\n      const maximum = Math.max(\n        0,\n        track.scrollWidth - track.clientWidth\n      );\n\n      left.hidden =\n        maximum < 2 || track.scrollLeft < 2;\n\n      right.hidden =\n        maximum < 2 ||\n        track.scrollLeft >= maximum - 2;\n    }\n\n    \/* SET SCROLL POSITION *\/\n\n    function setPosition(x) {\n\n      const old = track.style.scrollBehavior;\n\n      track.style.scrollBehavior = 'auto';\n\n      track.scrollLeft = Math.max(\n        0,\n        Math.min(\n          x,\n          track.scrollWidth - track.clientWidth\n        )\n      );\n\n      track.style.scrollBehavior = old;\n    }\n\n    \/* SHOW ACTIVE COLLECTION *\/\n\n    function showActiveIfNeeded() {\n\n      if (!activeLink) return;\n\n      const leftEdge = track.scrollLeft + 36;\n\n      const rightEdge =\n        track.scrollLeft + track.clientWidth - 36;\n\n      const itemLeft = activeLink.offsetLeft;\n\n      const itemRight =\n        itemLeft + activeLink.offsetWidth;\n\n      if (itemLeft < leftEdge) {\n\n        setPosition(itemLeft - 40);\n\n      } else if (itemRight > rightEdge) {\n\n        setPosition(\n          itemRight - track.clientWidth + 40\n        );\n      }\n    }\n\n    \/* INITIAL POSITION *\/\n\n    const cached = isHistoryReturn\n      ? read(PAGE_KEY + currentPath)\n      : null;\n\n    const restore = incoming\n      ? incoming.x\n      : cached && Number.isFinite(cached.x)\n        ? cached.x\n        : null;\n\n    function initialPosition() {\n\n      if (restore !== null) {\n\n        setPosition(restore);\n\n      } else if (\n        pageType === 'collection' ||\n        (pageType === 'product' && context)\n      ) {\n\n        showActiveIfNeeded();\n\n      } else {\n\n        setPosition(0);\n      }\n\n      updateArrows();\n    }\n\n    \/* SAVE CURRENT POSITION *\/\n\n    function storeCurrentPosition() {\n\n      write(PAGE_KEY + currentPath, {\n        x: track.scrollLeft,\n        at: Date.now()\n      });\n    }\n\n    \/* REMEMBER COLLECTION AND PRODUCT CLICKS *\/\n\n    function onLinkClick(event) {\n\n      if (!root.isConnected) return;\n\n      if (\n        event.defaultPrevented ||\n        event.button !== 0 ||\n        event.metaKey ||\n        event.ctrlKey ||\n        event.shiftKey ||\n        event.altKey\n      ) {\n        return;\n      }\n\n      const link =\n        event.target.closest &&\n        event.target.closest('a[href]');\n\n      if (\n        !link ||\n        link.hasAttribute('download') ||\n        (link.target && link.target !== '_self')\n      ) {\n        return;\n      }\n\n      let url;\n\n      try {\n        url = new URL(link.href, location.href);\n      } catch (e) {\n        return;\n      }\n\n      if (\n        url.origin !== location.origin ||\n        !\/\\\/(?:collections\\\/[^\/]+|products\\\/[^\/]+)\/.test(\n          url.pathname\n        )\n      ) {\n        return;\n      }\n\n      storeCurrentPosition();\n\n      write(TRANSFER_KEY, {\n        to: normalize(url.pathname),\n        x: track.scrollLeft,\n        context: root.dataset.activeContext || '',\n        at: Date.now()\n      });\n    }\n\n    \/* ARROW SCROLLING *\/\n\n    function reducedMotion() {\n      return window.matchMedia(\n        '(prefers-reduced-motion: reduce)'\n      ).matches;\n    }\n\n    left.addEventListener('click', function () {\n\n      track.scrollBy({\n        left: -260,\n        behavior: reducedMotion() ? 'auto' : 'smooth'\n      });\n    });\n\n    right.addEventListener('click', function () {\n\n      track.scrollBy({\n        left: 260,\n        behavior: reducedMotion() ? 'auto' : 'smooth'\n      });\n    });\n\n    \/* KEEP ARROWS UPDATED WHILE SWIPING *\/\n\n    let rafPending = false;\n\n    track.addEventListener('scroll', function () {\n\n      if (rafPending) return;\n\n      rafPending = true;\n\n      requestAnimationFrame(function () {\n\n        rafPending = false;\n\n        updateArrows();\n        storeCurrentPosition();\n      });\n\n    }, { passive: true });\n\n    \/* EVENT LISTENERS *\/\n\n    document.addEventListener(\n      'click',\n      onLinkClick,\n      true\n    );\n\n    window.addEventListener(\n      'pagehide',\n      storeCurrentPosition\n    );\n\n    window.addEventListener(\n      'pageshow',\n      updateArrows\n    );\n\n    function onResize() {\n\n      if (!root.isConnected) return;\n\n      fullWidth();\n      updateArrows();\n    }\n\n    window.addEventListener(\n      'resize',\n      onResize\n    );\n\n    let resizeObserver = null;\n\n    if ('ResizeObserver' in window) {\n\n      resizeObserver = new ResizeObserver(\n        updateArrows\n      );\n\n      resizeObserver.observe(track);\n    }\n\n    \/* SHOPIFY THEME EDITOR CLEANUP *\/\n\n    function onSectionUnload(event) {\n\n      if (!event.target.contains(root)) return;\n\n      document.removeEventListener(\n        'click',\n        onLinkClick,\n        true\n      );\n\n      window.removeEventListener(\n        'pagehide',\n        storeCurrentPosition\n      );\n\n      window.removeEventListener(\n        'pageshow',\n        updateArrows\n      );\n\n      window.removeEventListener(\n        'resize',\n        onResize\n      );\n\n      document.removeEventListener(\n        'shopify:section:unload',\n        onSectionUnload\n      );\n\n      if (resizeObserver) {\n        resizeObserver.disconnect();\n      }\n    }\n\n    document.addEventListener(\n      'shopify:section:unload',\n      onSectionUnload\n    );\n\n    \/* INITIALIZE *\/\n\n    fullWidth();\n    initialPosition();\n\n    if (document.fonts && document.fonts.ready) {\n\n      document.fonts.ready.then(function () {\n\n        if (!root.isConnected) return;\n\n        fullWidth();\n        updateArrows();\n      });\n    }\n  }\n\n  function initAll(scope) {\n\n    scope.querySelectorAll(\n      '.susans-collection-nav'\n    ).forEach(init);\n  }\n\n  initAll(document);\n\n  document.addEventListener(\n    'shopify:section:load',\n    function (event) {\n      initAll(event.target);\n    }\n  );\n\n})();\n<\/script>","desktop_width_percent":100},"blocks":{}}},"block_order":["ai_gen_block_5a00a50_gdh6RQ","ai_gen_block_5a00a50_tmYV9A"],"custom_css":[],"name":"Custom liquid","settings":{}},"slideshow_kxNpej":{"type":"slideshow","blocks":{"image_hermN8":{"type":"image","settings":{"top_subheading":"","title":"","title_size":80,"subheading":"","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-center horizontal-center","image":"shopify:\/\/shop_images\/Retirement_Sale_Desktop.png","image_mobile":"shopify:\/\/shop_images\/Blouses_2bc1c6c0-e773-43e1-a346-8bf5b013b8b4.png","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["image_hermN8"],"name":"Hero (optional slidesho