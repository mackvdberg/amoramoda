.susans-countdown-title {\n      font-size: 11px;\n      letter-spacing: 1.2px;\n    }\n\n    .susans-time-number {\n      font-size: 19px;\n      line-height: 19px;\n    }\n\n    .susans-time-label {\n      font-size: 8px;\n      margin-top: 2px;\n    }\n\n    .susans-time-colon {\n      font-size: 17px;\n      line-height: 18px;\n    }\n\n    .susans-time-unit {\n      min-width: 27px;\n    }\n  }\n\n  @media screen and (max-width: 359px) {\n    .susans-countdown-inner {\n      gap: 5px;\n    }\n\n    .susans-countdown-title {\n      font-size: 10px;\n      letter-spacing: 0.6px;\n    }\n\n    .susans-countdown-time {\n      gap: 2px;\n    }\n\n    .susans-time-unit {\n      min-width: 25px;\n    }\n  }\n<\/style>\n\n<div class=\"susans-countdown-bar\">\n  <div class=\"susans-countdown-inner\">\n\n    <div class=\"susans-countdown-title\">\n      Sale Ends In\n    <\/div>\n\n    <div class=\"susans-countdown-time\">\n\n      <div class=\"susans-time-unit\">\n        <span class=\"susans-time-number\"\n              data-susans-hours>00<\/span>\n        <span class=\"susans-time-label\">HRS<\/span>\n      <\/div>\n\n      <span class=\"susans-time-colon\">:<\/span>\n\n      <div class=\"susans-time-unit\">\n        <span class=\"susans-time-number\"\n              data-susans-minutes>00<\/span>\n        <span class=\"susans-time-label\">MINS<\/span>\n      <\/div>\n\n      <span class=\"susans-time-colon\">:<\/span>\n\n      <div class=\"susans-time-unit\">\n        <span class=\"susans-time-number\"\n              data-susans-seconds>00<\/span>\n        <span class=\"susans-time-label\">SECS<\/span>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\n(function () {\n\n  function getNextMidnight() {\n    const now = new Date();\n\n    return new Date(\n      now.getFullYear(),\n      now.getMonth(),\n      now.getDate() + 1,\n      0, 0, 0, 0\n    ).getTime();\n  }\n\n  document.querySelectorAll(\n    '.susans-countdown-bar'\n  ).forEach(function (bar) {\n\n    if (bar.dataset.timerInitialized) return;\n    bar.dataset.timerInitialized = 'true';\n\n    const hoursEl = bar.querySelector(\n      '[data-susans-hours]'\n    );\n\n    const minutesEl = bar.querySelector(\n      '[data-susans-minutes]'\n    );\n\n    const secondsEl = bar.querySelector(\n      '[data-susans-seconds]'\n    );\n\n    let targetTime = getNextMidnight();\n\n    function updateCountdown() {\n      const now = Date.now();\n\n      if (now >= targetTime) {\n        targetTime = getNextMidnight();\n      }\n\n      const distance = Math.max(\n        0,\n        Math.ceil((targetTime - now) \/ 1000)\n      );\n\n      const hours = Math.floor(\n        distance \/ 3600\n      );\n\n      const minutes = Math.floor(\n        (distance % 3600) \/ 60\n      );\n\n      const seconds = distance % 60;\n\n      hoursEl.textContent =\n        String(hours).padStart(2, '0');\n\n      minutesEl.textContent =\n        String(minutes).padStart(2, '0');\n\n      secondsEl.textContent =\n        String(seconds).padStart(2, '0');\n    }\n\n    updateCountdown();\n\n    const interval = setInterval(function () {\n      if (!bar.isConnected) {\n        clearInterval(interval);\n        return;\n      }\n\n      updateCountdown();\n    }, 1000);\n\n  });\n\n})();\n<\/script>","desktop_width_percent":100},"blocks":{}},"ai_gen_block_06912cd_Pgy6Ed":{"type":"ai_gen_block_06912cd","settings":{"custom_liquid":"<style>\n\/* Susan's Aspen Boutique | Collection navigation *\/\n\n.susans-collection-nav,\n.susans-collection-nav * {\n  box-sizing: border-box;\n}\n\n.susans-collection-nav {\n  position: relative;\n  width: 100%;\n  background: #FFFFFF;\n  border-top: 1px solid rgba(31,31,31,.10);\n  border-bottom: 1px solid rgba(31,31,31,.10);\n  font-family: 'Outfit', sans-serif;\n  isolation: isolate;\n}\n\n.susans-collection-nav__track {\n  display: flex;\n  position: relative;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  height: 42px;\n  padding: 0 30px;\n  margin: 0;\n  gap: 16px;\n  white-space: nowrap;\n  overflow-x: auto;\n  overflow-y: hidden;\n  scrollbar-width: none;\n  -ms-overflow-style: none;\n  -webkit-overflow-scrolling: touch;\n  scroll-behavior: smooth;\n}\n\n.susans-collection-nav__track::-webkit-scrollbar {\n  display: none;\n}\n\n\/* Collection links *\/\n\n.susans-collection-nav__link {\n  position: relative;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  color: #1F1F1F !important;\n  font-family: 'Outfit', sans-serif;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: .7px;\n  line-height: 1.2;\n  text-transform: uppercase;\n  text-decoration: none !important;\n  transition: opacity .2s ease;\n}\n\n.susans-collection-nav__link:hover {\n  opacity: .7;\n}\n\n.susans-collection-nav__link:focus-visible {\n  outline: 2px solid #4A382B;\n  outline-offset: -3px;\n}\n\n\/* Featured collections *\/\n\n.susans-collection-nav__link--featured {\n  color: #4A382B !important;\n  font-weight: 700;\n}\n\n\/* Active collection *\/\n\n.susans-collection-nav__link.is-active {\n  font-weight: 700;\n}\n\n.susans-collection-nav__link.is-active::after {\n  content: '';\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 5px;\n  height: 1px;\n  background: currentColor;\n}\n\n\/* Original-style arrows without glow *\/\n\n.susans-collection-nav__arrow {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  z-index: 4;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 34px;\n  min-width: 0;\n  min-height: 0;\n  padding: 0;\n  margin: 0;\n  border: 0 !important;\n  border-radius: 0 !important;\n  appearance: none;\n  -webkit-appearance: none;\n  background: #FFFFFF !important;\n  color: #1F1F1F !important;\n  box-shadow: none !important;\n  filter: none !important;\n  text-shadow: none !important;\n  font: 300 21px\/1 Arial, sans-serif;\n  cursor: pointer;\n}\n\n.susans-collection-nav__arrow::before,\n.susans-collection-nav__arrow::after {\n  content: none !important;\n}\n\n.susans-collection-nav__arrow:hover {\n  background: #FFFFFF !important;\n  box-shadow: none !important;\n}\n\n.susans-collection-nav__arrow:focus-visible {\n  outline: 2px solid #4A382B;\n  outline-offset: -2px;\n}\n\n.susans-collection-nav__arrow[hidden] {\n  display: none !important;\n}\n\n.susans-collection-nav__arrow--left {\n  left: 0;\n}\n\n.susans-collection-nav__arrow--right {\n  right: 0;\n}\n\n\/* Tablet *\/\n\n@media (max-width: 1280px) {\n  .susans-collection-nav__track {\n    height: 40px;\n    justify-content: flex-start;\n    gap: 24px;\n    padding: 0 40px;\n  }\n\n  .susans-collection-nav__link.is-active::after {\n    bottom: 4px;\n  }\n}\n\n\/* Mobile *\/\n\n@media (max-width: 749px) {\n  .susans-collection-nav__track {\n    gap: 21px;\n    padding: 0 36px;\n  }\n\n  .susans-collection-nav__link {\n    font-size: 11px;\n    letter-spacing: .6px;\n  }\n\n  .susans-collection-nav__arrow {\n    width: 30px;\n  }\n}\n\n\/* Small mobile *\/\n\n@media (max-width: 359px) {\n  .susans-collection-nav__track {\n    gap: 18px;\n    padding: 0 34px;\n  }\n\n  .susans-collection-nav__link {\n    font-size: 10.5px;\n    letter-spacing: .4px;\n  }\n\n  .susans-collection-nav__arrow {\n    width: 28px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .susans-collection-nav__track {\n    scroll-behavior: auto;\n  }\n\n  .susans-collection-nav__link {\n    transition: none;\n  }\n}\n<\/style>\n\n<div\n  class=\"susans-collection-nav\"\n  data-page-type=\"{{ request.page_type }}\"\n  data-collection-handle=\"{% if collection %}{{ collection.handle | escape }}{% endif %}\"\n>\n\n  <!-- LEFT ARROW -->\n\n  <button\n    type=\"button\"\n    class=\"susans-collection-nav__arrow susans-collection-nav__arrow--left\"\n    aria-label=\"Scroll collections left\"\n    hidden\n  >&#8249;<\/button>\n\n  <!-- COLLECTION LINKS -->\n\n  <nav\n    class=\"susans-collection-nav__track\"\n    aria-label=\