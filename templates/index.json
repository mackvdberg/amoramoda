ass=\"susans-collection-nav__link{% if request.page_type == 'collection' and collection.handle == 'coats-jackets' %} is-active{% endif %}\"\n      {% if request.page_type == 'collection' and collection.handle == 'coats-jackets' %}aria-current=\"page\"{% endif %}\n    >Coats &amp; Jackets<\/a>\n\n    <!-- AUTUMN DRESSES -->\n\n    <a\n      href=\"\/collections\/autumn-dresses-1\"\n      data-handle=\"autumn-dresses-1\"\n      class=\"susans-collection-nav__link{% if request.page_type == 'collection' and collection.handle == 'autumn-dresses-1' %} is-active{% endif %}\"\n      {% if request.page_type == 'collection' and collection.handle == 'autumn-dresses-1' %}aria-current=\"page\"{% endif %}\n    >Autumn Dresses<\/a>\n\n    <!-- BUTTON-UP BLOUSES -->\n\n    <a\n      href=\"\/collections\/vintage-button-ups-1\"\n      data-handle=\"vintage-button-ups-1\"\n      class=\"susans-collection-nav__link{% if request.page_type == 'collection' and collection.handle == 'vintage-button-ups-1' %} is-active{% endif %}\"\n      {% if request.page_type == 'collection' and collection.handle == 'vintage-button-ups-1' %}aria-current=\"page\"{% endif %}\n    >Button-Up Blouses<\/a>\n\n    <!-- BLAZERS -->\n\n    <a\n      href=\"\/collections\/statement-blazers\"\n      data-handle=\"statement-blazers\"\n      class=\"susans-collection-nav__link{% if request.page_type == 'collection' and collection.handle == 'statement-blazers' %} is-active{% endif %}\"\n      {% if request.page_type == 'collection' and collection.handle == 'statement-blazers' %}aria-current=\"page\"{% endif %}\n    >Blazers<\/a>\n\n    <!-- EVERYDAY EDIT -->\n\n    <a\n      href=\"\/collections\/the-everyday-edit\"\n      data-handle=\"the-everyday-edit\"\n      class=\"susans-collection-nav__link{% if request.page_type == 'collection' and collection.handle == 'the-everyday-edit' %} is-active{% endif %}\"\n      {% if request.page_type == 'collection' and collection.handle == 'the-everyday-edit' %}aria-current=\"page\"{% endif %}\n    >Everyday Edit<\/a>\n\n  <\/nav>\n\n  <!-- RIGHT ARROW -->\n\n  <button\n    type=\"button\"\n    class=\"susans-collection-nav__arrow susans-collection-nav__arrow--right\"\n    aria-label=\"Scroll collections right\"\n    hidden\n  >&#8250;<\/button>\n\n<\/div>\n\n<script>\n(function () {\n\n  const TRANSFER_KEY = 'susans_nav_transfer_v6';\n  const PAGE_KEY = 'susans_nav_page_v6:';\n  const TRANSFER_LIFETIME = 5 * 60 * 1000;\n\n  function normalize(path) {\n    return path.replace(\/\\\/+$\/, '') || '\/';\n  }\n\n  const currentPath = normalize(location.pathname);\n\n  const navEntry =\n    performance.getEntriesByType &&\n    performance.getEntriesByType('navigation')[0];\n\n  const isHistoryReturn =\n    navEntry && navEntry.type === 'back_forward';\n\n  function read(key) {\n    try {\n      return JSON.parse(\n        sessionStorage.getItem(key) || 'null'\n      );\n    } catch (e) {\n      return null;\n    }\n  }\n\n  function write(key, value) {\n    try {\n      sessionStorage.setItem(\n        key,\n        JSON.stringify(value)\n      );\n    } catch (e) {\n      \/\/ Navigation still works without storage.\n    }\n  }\n\n  function remove(key) {\n    try {\n      sessionStorage.removeItem(key);\n    } catch (e) {}\n  }\n\n  function init(root) {\n\n    if (root.dataset.susansNavReady === '1') {\n      return;\n    }\n\n    const track = root.querySelector(\n      '.susans-collection-nav__track'\n    );\n\n    const left = root.querySelector(\n      '.susans-collection-nav__arrow--left'\n    );\n\n    const right = root.querySelector(\n      '.susans-collection-nav__arrow--right'\n    );\n\n    if (!track || !left || !right) return;\n\n    root.dataset.susansNavReady = '1';\n\n    const pageType = root.dataset.pageType || '';\n    const liquidContext =\n      root.dataset.collectionHandle || '';\n\n    \/* RESTORE NAVIGATION CONTEXT *\/\n\n    const transfer = read(TRANSFER_KEY);\n\n    remove(TRANSFER_KEY);\n\n    const incoming = transfer &&\n      transfer.to === currentPath &&\n      Number.isFinite(transfer.x) &&\n      Date.now() - transfer.at >= 0 &&\n      Date.now() - transfer.at < TRANSFER_LIFETIME\n        ? transfer\n        : null;\n\n    const contextFromUrl = location.pathname.match(\n      \/\\\/collections\\\/([^\/]+)\\\/products\\\/\/\n    );\n\n    let context =\n      pageType === 'collection'\n        ? liquidContext\n        : pageType === 'product'\n          ? (\n              liquidContext ||\n              (contextFromUrl && contextFromUrl[1]) ||\n              (incoming && incoming.context) ||\n              ''\n            )\n          : '';\n\n    const activeLink = Array.from(\n      track.querySelectorAll('[data-handle]')\n    ).find(function (link) {\n      return link.dataset.handle === context;\n    });\n\n    if (pageType === 'product' && activeLink) {\n      activeLink.classList.add('is-active');\n    }\n\n    root.dataset.activeContext = context;\n\n    \/* FULL VIEWPORT WIDTH *\/\n\n    function fullWidth() {\n\n      root.style.width = '100%';\n      root.style.marginLeft = '0px';\n\n      const x = root.getBoundingClientRect().left;\n\n      root.style.width =\n        document.documentElement.clientWidth + 'px';\n\n      root.style.marginLeft = -x + 'px';\n    }\n\n    \/* ARROW VISIBILITY *\/\n\n    function updateArrows() {\n\n      const maximum = Math.max(\n        0,\n        track.scrollWidth - track.clientWidth\n      );\n\n      left.hidden =\n        maximum < 2 || track.scrollLeft < 2;\n\n      right.hidden =\n        maximum < 2 ||\n        track.scrollLeft >= maximum - 2;\n    }\n\n    \/* SET SCROLL POSITION *\/\n\n    function setPosition(x) {\n\n      const old = track.style.scrollBehavior;\n\n      track.style.scrollBehavior = 'auto';\n\n      track.scrollLeft = Math.max(\n        0,\n        Math.min(\n          x,\n          track.scrollWidth - track.clientWidth\n        )\n      );\n\n      track.style.scrollBehavior = old;\n    }\n\n    \/* SHOW ACTIVE COLLECTION *\/\n\n    function showActiveIfNeeded() {\n\n      if (!activeLink) return;\n\n      const leftEdge = track.scrollLeft + 36;\n\n      const rightEdge =\n        track.scrollLeft + track.clientWidth - 36;\n\n      const itemLeft = activeLink.offsetLeft;\n\n      const itemRight =\n        itemLeft + activeLink.offsetWidth;\n\n      if (itemLeft < leftEdge) {\n\n        setPosition(itemLeft - 40);\n\n      } else if (itemRight > rightEdge) {\n\n        setPosition(\n          itemRight - track.clientWidth + 40\n        );\n      }\n    }\n\n    \/* INITIAL POSITION *\/\n\n    const cached = isHistoryReturn\n      ? read(PAGE_KEY + currentPath)\n      : null;\n\n    const restore = incoming\n      ? incoming.x\n      : cached && Number.isFinite(cached.x)\n        ? cached.x\n        : null;\n\n    function initialPosition() {\n\n      if (restore !== null) {\n\n        setPosition(restore);\n\n      } else if (\n        pageType === 'collection' ||\n        (pageType === 'product' && context)\n      ) {\n\n        showActiveIfNeeded();\n\n      } else {\n\n        setPosition(0);\n      }\n\n      updateArrows();\n    }\n\n    \/* SAVE CURRENT POSITION *\/\n\n    function storeCurrentPosition() {\n\n      write(PAGE_KEY + currentPath, {\n        x: track.scrollLeft,\n        at: Date.now()\n      });\n    }\n\n    \/* REMEMBER COLLECTION AND PRODUCT CLICKS *\/\n\n    function onLinkClick(event) {\n\n      if (!root.isConnected) return;\n\n      if (\n        event.defaultPrevented ||\n        event.button !== 0 ||\n        event.metaKey ||\n        event.ctrlKey ||\n        event.shiftKey ||\n        event.altKey\n      ) {\n        return;\n      }\n\n      const link =\n        event.target.closest &&\n        event.target.closest('a[href]');\n\n      if (\n        !link ||\n        link.hasAttribute('download') ||\n        (link.target && link.target !== '_self')\n      ) {\n        return;\n      }\n\n      let url;\n\n      try {\n        url = new URL(link.href, location.href);\n      } catch (e) {\n        return;\n      }\n\n      if (\n        url.origin !== location.origin ||\n        !\/\\\/(?:collections\\\/[^\/]+|products\\\/[^\/]+)\/.test(\n          url.pathname\n        )\n      ) {\n        return;\n      }\n\n      storeCurrentPosition();\n\n      write(TRANSFER_KEY, {\n        to: normalize(url.pathname),\n        x: track.scrollLeft,\n        context: root.dataset.activeContext || '',\n        at: Date.now()\n      });\n    }\n\n    \/* ARROW SCROLLING *\/\n\n    function reducedMotion() {\n      return window.matchMedia(\n        '(prefers-reduced-motion: reduce)'\n      ).matches;\n    }\n\n    left.addEventListener('click', function () {\n\n      track.scrollBy({\n        left: -260,\n        behavior: reducedMotion() ? 'auto' : 'smooth'\n      });\n    });\n\n    right.addEventListener('click', function () {\n\n      track.scrollBy({\n        left: 260,\n        behavior: reducedMotion() ? 'auto' : 'smooth'\n      });\n    });\n\n    \/* KEEP ARROWS UPDATED WHILE SWIPING *\/\n\n    let rafPending = false;\n\n    track.addEventListener('scroll', function () {\n\n      if (rafPending) return;\n\n      rafPending = true;\n\n      requestAnimationFrame(function () {\n\n        rafPending = false;\n\n        updateArrows();\n        storeCurrentPosition();\n      });\n\n    }, { passive: true });\n\n    \/* EVENT LISTENERS *\/\n\n    document.addEventListener(\n      'click',\n      onLinkClick,\n      true\n    );\n\n    window.addEventListener(\n      'pagehide',\n      storeCurrentPosition\n    );\n\n    window.addEventListener(\n      'pageshow',\n      updateArrows\n    );\n\n    function onResize() {\n\n      if (!root.isConnected) return;\n\n      fullWidth();\n      updateArrows();\n    }\n\n    window.addEventListener(\n      'resize',\n      onResize\n    );\n\n    let resizeObserver = null;\n\n    if ('ResizeObserver' in window) {\n\n      resizeObserver = new ResizeObserver(\n        updateArrows\n      );\n\n      resizeObserver.observe(track);\n    }\n\n    \/* SHOPIFY THEME EDITOR CLEANUP *\/\n\n    function onSectionUnload(event) {\n\n      if (!event.target.contains(root)) return;\n\n      document.removeEventListener(\n        'click',\n        onLinkClick,\n        true\n      );\n\n      window.removeEventListener(\n        'pagehide',\n        storeCurrentPosition\n      );\n\n      window.removeEventListener(\n        'pageshow',\n        updateArrows\n      );\n\n      window.removeEventListener(\n        'resize',\n        onResize\n      );\n\n      document.removeEventListener(\n        'shopify:section:unload',\n        onSectionUnload\n      );\n\n      if (resizeObserver) {\n        resizeObserver.disconnect();\n      }\n    }\n\n    document.addEventListener(\n      'shopify:section:unload',\n      onSectionUnload\n    );\n\n    \/* INITIALIZE *\/\n\n    fullWidth();\n    initialPosition();\n\n    if (document.fonts && document.fonts.ready) {\n\n      document.fonts.ready.then(function () {\n\n        if (!root.isConnected) return;\n\n        fullWidth();\n        updateArrows();\n      });\n    }\n  }\n\n  function initAll(scope) {\n\n    scope.querySelectorAll(\n      '.susans-collection-nav'\n    ).forEach(init);\n  }\n\n  initAll(document);\n\n  document.addEventListener(\n    'shopify:section:load',\n    function (event) {\n      initAll(event.target);\n    }\n  );\n\n})();\n<\/script>","desktop_width_percent":100},"blocks":{}}},"block_order":["ai_gen_block_06912cd_whbtLd","ai_gen_block_5a00a50_9XJitA","ai_gen_block_06912cd_Pgy6Ed"],"settings":{}},"slideshow_XGpN3P":{"type":"slideshow","blocks":{"image_qmNkGY":{"type":"image","settings":{"top_subheading":"","title":"","title_size":80,"subheading":"","link":"shopify:\/\/collections\/most-loved","link_text":"","link_2":"","link_text_2":"","color_accent":"#00b67b","text_align":"vertical-center horizontal-center","image":"shopify:\/\/shop_images\/hf_20260929_130224_1226378a-0086-4ec5-a1c1-60fdac7d68cb_1.png","image_mobile":"shopify:\/\/shop_images\/hf_20260929_130224_1_d927a237-3a58-4031-b45e-7dc1c3e39df2.png","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["image_qmNkGY"],"settings":{"section_height":"natural","mobile_height":"auto","parallax":false,"style":"bars","autoplay":false,"autoplay_speed":5}},"blocks_gU6GJr":{"type":"_blocks","blocks":{"ai_gen_block_5a00a50_JPzTkC":{"type":"ai_gen_block_5a00a50","settings":{"custom_liquid":"<a href=\"https:\/\/susans-aspenboutique.com\/collections\/most-loved\" class=\"susans-collection-button\">\n  SHOP OUR MOST LOVED STYLES\n  <span aria-hidden=\"true\">→<\/span>\n<\/a>\n\n<style>\n  .susans-collection-button {\n    width: 100%;\n    min-height: 38px;\n    padding: 9px 18px;\n    box-sizing: border-box;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n\n    background: #4A382B;\n    color: #FFFFFF !important;\n\n    font-family: 'Outfit', sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 1.4px;\n    text-transform: uppercase;\n    text-decoration: none !important;\n\n    border: 1px solid #4A382B;\n    transition:\n      background-color 0.2s ease,\n      color 0.2s ease;\n  }\n\n  .susans-collection-button:hover {\n    background: #604B3B;\n    color: #FFFFFF !important;\n  }\n\n  .susans-collection-button span {\n    font-size: 15px;\n    line-height: 1;\n    transition: transform 0.2s ease;\n  }\n\n  .susans-collection-button:hover span {\n    transform: translateX(3px);\n  }\n\n  @media screen and (max-width: 749px) {\n    .susans-collection-button {\n      min-height: 36px;\n      padding: 8px 14px;\n      font-size: 10px;\n      letter-spacing: 1.2px;\n    }\n\n    .susans-collection-button span {\n      font-size: 14px;\n    }\n  }\n<\/style>","desktop_width_percent":100},"blocks":{}}},"block_order":["ai_gen_block_5a00a50_JPzTkC"],"name":"Custom liquid","settings":{}},"rich_text_Agx4tL":{"type":"rich-text","blocks":{"heading_QMtiTP":{"type":"heading","settings":{"title":"A MOTHER’S PASSION. A DAUGHTER’S NEXT CHAPTER."}},"text_UJf3Qd":{"type":"text","settings":{"enlarge_text":false,"text":"<p>For&nbsp;<strong>over 30 years<\/strong>, Susan has filled her Aspen boutique with timeless pieces and a personal touch that turned customers into friends.<\/p><p>Now,&nbsp;she’s preparing to&nbsp;<strong>retire and&nbsp;pass the boutique on to her daughter, Olivia<\/strong>, who grew up alongside her in the store.<\/p><p>Olivia is bringing a fresh perspective and welcoming women across America online, while preserving the warmth and care her mother is known for.<\/p><p>To celebrate Susan’s retirement and this special transition, our&nbsp;<strong>Retirement Sale offers up to 60% off selected styles<\/strong>,&nbsp;making room for the collection to come.<\/p><p><strong>The same heart. The same personal touch.&nbsp;A beautiful new chapter.<\/strong><\/p><p>Thank you for being part of&nbsp;<strong>Susan’s Aspen Boutique<\/strong>. 🤍<\/p>"}}},"block_order":["heading_QMtiTP","text_UJf3Qd"],"disabled":true,"name":"Rich text","settings":{"align_text":"center","narrow_column":true,"divider":false}},"1790774330ca5b968e":{"type":"apps","blocks":{"section_store_block_space_divide_XddDyh":{"type":"shopify:\/\/apps\/section-store\/blocks\/block-space-divide\/d7a2e423-ea88-4344-b866-6d0fb487c3dd","disabled":true,"settings":{"height":20,"background_color":"rgba(0,0,0,0)","show_line":true,"line_style":"solid","line_width":100,"line_thickness":1,"line_roundness":0,"line_color":"#053a23","custom_css":""}}},"block_order":["section_store_block_space_divide_XddDyh"],"settings":{"full_width":false,"space_around":true}},"blocks_i9Wixp":{"type":"_blocks","blocks":{"ai_gen_block_a930d6f_dH6wN9":{"type":"ai_gen_block_a930d6f","settings":{"desktop_width_percent":100,"line_color":"#d0d0d0","thickness":1,"line_style":"solid","vertical_spacing":15},"blocks":{}}},"block_order":["ai_gen_block_a930d6f_dH6wN9"],"name":"Separator line","settings":{}},"featured_collection_qLQGbj":{"type":"featured-collection","name":"Featured collection","settings":{"title":"MOST LOVED","home_featured_products":"most-loved","per_row":4,"rows":2,"mobile_scrollable":true,"view_all":true,"divider":false}},"text_and_image_EpC6dy":{"type":"text-and-image","disabled":true,"name":"Image with text","settings":{"image":"shopify:\/\/shop_images\/Susan_Olivia_626fa9e4-149f-4541-9feb-1e6f8691d9b7.png","image2":"shopify:\/\/shop_images\/Olivia_7_Susan_cc0abad4-cdd1-45f2-bb04-46a35599a0bd.png","image_width":700,"subtitle":"","title":"FROM ONE GENERATION TO THE NEXT","text":"<p>For more than&nbsp;<strong>30 years<\/strong>, Susan’s Aspen Boutique has been part of our family.<\/p><p>My mother, Susan, opened the boutique with a simple belief: beautiful clothing should feel personal, be chosen with care, and remain part of your wardrobe for seasons to come.<\/p><p>I grew up around the boutique, watching her select every piece with the same attention she would give to a close friend. Now, I have the privilege of joining her and helping carry that approach into a new chapter.<\/p><p>As we bring Susan’s Aspen Boutique online, we’re staying true to what has always made it special: thoughtful collections, personal service, and pieces chosen to be worn and loved again and again.<\/p><p>In a world where small, independent boutiques are becoming harder to find, every order genuinely means something to us.<\/p><p>🤍&nbsp;<strong>When you shop with Susan’s Aspen Boutique, you’re not simply choosing a piece you love. You’re helping us continue a family story that began more than 30 years ago in Aspen.<\/strong><\/p><p>With love,<br\/><strong>Susan & Olivia<\/strong><\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"center","layout":"right","divider":false}},"blocks_gxJVdb":{"type":"_blocks","blocks":{"ai_gen_block_a930d6f_w4WEe6":{"type":"ai_gen_block_a930d6f","settings":{"desktop_width_percent":100,"line_color":"#d0d0d0","thickness":1,"line_style":"solid","vertical_spacing":15},"blocks":{}}},"block_order":["ai_gen_block_a930d6f_w4WEe6"],"name":"Separator line","settings":{}},"featured_collection_3ALpBb":{"type":"featured-collection","name":"Featured collection","settings":{"title":"THE FALL FAVORITES","home_featured_products":"jackets","per_row":4,"rows":1,"mobile_scrollable":true,"view_all":true,"divider":false}},"background_image_text_cfE8ir":{"type":"background-image-text","name":"Large image with text box","settings":{"subtitle":"SUSAN’S ASPEN BOUTIQUE","title":"American Quality & Craftsmanship","text":"<p>Inspired by Aspen’s relaxed elegance, we select timeless pieces that bring together American craftsmanship, everyday comfort, and effortless style.<\/p><p>Soft fabrics, flattering fits, and thoughtful details. Clothing to feel beautiful in and reach for again and again.<\/p><p>Chosen with care,<br\/><strong>Susan & Olivia 🤍<\/strong><\/p>","button_label":"","button_link":"","image":"shopify:\/\/shop_images\/aspensunset_40a6ac9e-53c9-49ad-b38a-43124fa21899.webp","focal_point":"center","layout":"left","height":650,"framed":false,"parallax":false}},"text_columns_YnQVDV":{"type":"text-columns","blocks":{"text_block_9WWfby":{"type":"text_block","settings":{"enable_image":true,"image_width":60,"title":"FREE SHIPPING","text":"<p>Free shipping on every order across the U.S. this week only. We’ll deliver straight to your door, safely and without extra cost.<br\/><br\/><\/p>","button_label":"","button_link":""}},"text_block_F88kgY":{"type":"text_block","settings":{"enable_image":true,"image_width":60,"title":"Easy returns","text":"<p>Shop with confidence. Every order comes with a 30-day money back guarantee, so you can try us risk-free.<\/p>","button_label":"","button_link":""}},"text_block_wMFFKF":{"type":"text_block","settings":{"enable_image":true,"image_width":60,"title":"24\/7 CUSTOMER SERVICE","text":"<p>Available 24\/7 for personalized support.<br\/>Professional, reliable, and always here for you.<\/p>","button_label":"","button_link":""}}},"block_order":["text_block_9WWfby","text_block_F88kgY","text_block_wMFFKF"],"disabled":true,"name":"Text columns with images","settings":{"title":"","align_text":"center","divider":false}},"featured_collections_V69yeg":{"type":"featured-collections","blocks":{"collection_CDrHwQ":{"type":"collection","settings":{"collection":"sweaters-hoodies","title":"Sweaters & Hoodies","focal_point":"center center"}},"collection_WYMJdB":{"type":"collection","settings":{"collection":"two-piece-sets-jumpsuits","title":"Two-Piece Sets & Jumpsuits","focal_point":"center center"}},"collection_7tkGkx":{"type":"collection","settings":{"collection":"blouses","title":"Blouses","focal_point":"center center"}},"collection_APEJRN":{"type":"collection","settings":{"collection":"quilted-jackets","title":"Quilted Jackets","focal_point":"center center"}},"collection_TmiVYB":{"type":"collection","settings":{"collection":"jackets","title":"Jackets","focal_point":"center center"}},"collection_hW9BVq":{"type":"collection","settings":{"collection":"statement-blazers","title":"Statement Blazers","focal_point":"center center"}},"collection_t3Gjnx":{"type":"collection","settings":{"collection":"turtleneck-sweaters","title":"Turtleneck Sweaters","focal_point":"center center"}},"collection_BeJjmz":{"type":"collection","settings":{"collection":"weatherproof-coats","title":"Weatherproof Coats","focal_point":"center center"}}},"block_order":["collection_CDrHwQ","collection_WYMJdB","collection_7tkGkx","collection_APEJRN","collection_TmiVYB","collection_hW9BVq","collection_t3Gjnx","collection_BeJjmz"],"custom_css":["h2 {font-size: 22px;}"],"name":"Collection list","settings":{"title":"FAVORITE COLLECTIONS — Now Up to 60% Off.","divider":false,"per_row":4,"enable_gutter":true}},"faq_K7V8Pg":{"type":"faq","blocks":{"question_eCeqhb":{"type":"question","settings":{"title":"How can I contact you?","text":"<p>We’re happy to help with sizing, delivery, or any questions about your order. Simply <a href=\"\/pages\/contact\" title=\"Contact\"><strong>visit our Contact page<\/strong><\/a> and send us a message. If you’re contacting us about an existing order, please include <strong>your order number<\/strong> so we can help you more quickly.<\/p>"}},"question_GmBtYt":{"type":"question","settings":{"title":"Can I change or cancel my order?","text":"<p>Changed your mind or noticed a mistake? <a href=\"\/pages\/contact\" title=\"Contact\"><strong>Contact us as soon as possible<\/strong><\/a> with your order number and what you’d like to change. We’ll do our best to help, although we may be unable to make changes or cancel once your order is being prepared or has shipped.<\/p>"}},"question_KzCxXL":{"type":"question","settings":{"title":"How long will it take to receive my order?","text":"<p>Please allow <strong>1–3 business days for processing<\/strong>, followed by an estimated <strong>5–8 business days for delivery<\/strong>. Your order should usually arrive within <strong>6–11 business days<\/strong> of being placed. For more details, [view our Shipping Policy]. Have a question about your delivery? <a href=\"\/pages\/contact\" title=\"Contact\">Contact us<\/a> with your order number, and we’ll be happy to help.<\/p>"}},"question_Wj6zaX":{"type":"question","settings":{"title":"Do you offer free shipping?","text":"<p>Yes! Enjoy <strong>free shipping on every order, with no minimum spend<\/strong>. It’s our little thank-you for shopping with Susan’s Aspen Boutique.<\/p>"}},"question_LwMpbE":{"type":"question","settings":{"title":"How can I track my order?","text":"<p>Once your order has shipped, we’ll email you <strong>your tracking details<\/strong>. You can also <strong>Track your order<\/strong> directly on our website to see the latest delivery updates. Need a hand? <a href=\"\/pages\/contact\" title=\"Contact\"><strong>Contact us <\/strong><\/a>with your order number, and we’ll be happy to help.<\/p>"}},"question_JY4bYR":{"type":"question","settings":{"title":"How do I choose the right size?","text":"<p>Our products are designed to fit <strong>true to size<\/strong>. You can find a detailed size chart on each product page to help you choose the perfect fit with confidence.<\/p>"}},"question_4jGjhq":{"type":"question","settings":{"title":"What is the Return Policy?","text":"<p>Not quite satisfied? No worries! You can easily and quickly return your order within 30 days of receipt. We make sure the process goes smoothly, so you don't have to worry.<\/p>"}}},"block_order":["question_eCeqhb","question_GmBtYt","question_KzCxXL","question_Wj6zaX","question_LwMpbE","question_JY4bYR","question_4jGjhq"],"custom_css":["h2,.collapsible-trigger,strong,b {color: #303030 !important;}",".collapsible-trigger {position: relative; width: 100%; padding: 24px 35px 24px 0 !important; border-bottom: 1px solid #d0d0d0 !important; text-align: left; font-weight: 700;}",".collapsible-trigger__icon {left: auto !important; right: 0 !important; border: 0 !important; background: none !important;}",".collapsible-trigger__icon:before {border: 0 !important;}",".collapsible-content__inner {padding: 18px 0 !important;}"],"name":"FAQ","settings":{"title":"FAQs"}},"179069279829c3c6e9":{"type":"_blocks","blocks":{"ai_gen_block_a930d6f_LiaF3G":{"type":"ai_gen_block_a930d6f","settings":{"desktop_width_percent":100,"line_color":"#d0d0d0","thickness":1,"line_style":"solid","vertical_spacing":15},"blocks":{}},"ai_gen_block_5a00a50_zJqJMr":{"type":"ai_gen_block_5a00a50","settings":{"custom_liquid":"<style>\n  .susans-usps {\n    width: 100%;\n    background: #FFFFFF;\n    padding: 38px 40px 32px;\n    box-sizing: border-box;\n  }\n\n  .susans-usps__grid {\n    width: 100%;\n    max-width: 1400px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    column-gap: 40px;\n    row-gap: 40px;\n  }\n\n  .susans-usps__item {\n  